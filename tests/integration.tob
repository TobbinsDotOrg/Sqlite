using Tobbins.Database.Sqlite;
int exercise() {
    var db=new SqliteConnection(":memory:");
    db.Execute("CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT UNIQUE, note TEXT, score REAL, bytes BLOB)");
    if(db.ExecuteWith("INSERT INTO users(name,note,score,bytes) VALUES(@name,@note,@score,@bytes)", ["name":"David 世界", "note":null, "score":Real("1.25"), "bytes":null])!=1){return 1;}
    if((int)db.LastInsertRowId()!=1){return 2;}
    if(db.Changes()!=1){return 3;}
    var users=db.Query("SELECT * FROM users");
    if(users.length!=1){return 4;}
    var user=(Map<string,mixed>)users[0];
    if((string)user["name"]!="David 世界"){return 5;}
    if((string)user["score"]!="1.25"){return 6;}
    if(IsNull(user["note"])!=1){return 7;}
    if(IsNull(db.QueryOne("SELECT id FROM users WHERE id=99"))!=1){return 8;}
    if(IsNull(db.ExecuteScalar("SELECT NULL"))!=1){return 9;}
    var blob=(Buffer)db.ExecuteScalar("SELECT X'00017FFF80'");
    if(blob.length!=5){return 10;}
    db.ExecuteWith("UPDATE users SET bytes=? WHERE id=?",[blob,1]);
    if((string)db.ExecuteScalar("SELECT hex(bytes) FROM users")!="00017FFF80"){return 11;}
    var prep=db.Prepare("INSERT INTO users(name) VALUES(?)");
    prep.ExecuteWith(["second"]);
    prep.ExecuteWith(["third"]);
    prep.Close();prep.Close();
    var caught=0;
    try {prep.ExecuteWith(["closed"]);}catch(Exception e){caught=caught+1;}
    try {db.ExecuteWith("INSERT INTO users(name) VALUES(?)",["second"]);}catch(Exception e){caught=caught+1;}
    try {db.ExecuteWith("SELECT ?",[]);}catch(Exception e){caught=caught+1;}
    try {db.ExecuteWith("INSERT INTO users(name) VALUES(@name)",["wrong":"bad"]);}catch(Exception e){caught=caught+1;}
    if(caught!=4){return 12;}
    var tx=db.BeginTransaction();
    tx.ExecuteWith("INSERT INTO users(name) VALUES(?)",["committed"]);tx.Commit();tx.Commit();
    var rollback=db.BeginTransaction();rollback.ExecuteWith("INSERT INTO users(name) VALUES(?)",["rolled back"]);rollback.Rollback();rollback.Rollback();
    if((int)db.ExecuteScalar("SELECT COUNT(*) FROM users")!=4){return 13;}
    var automatic=db.BeginTransaction();automatic.Execute("DELETE FROM users");automatic.dispose();
    if((int)db.ExecuteScalar("SELECT COUNT(*) FROM users")!=4){return 14;}
    if((string)db.ExecuteScalarWith("SELECT ?",[Integer("-9223372036854775808")])!="-9223372036854775808"){return 15;}
    if((string)db.ExecuteScalarWith("SELECT ?",[Integer("9223372036854775807")])!="9223372036854775807"){return 16;}
    if((string)db.ExecuteScalarWith("SELECT ?",[Real("-12.75")])!="-12.75"){return 17;}
    if((string)db.ExecuteScalarWith("SELECT ?",["O'Brien; DROP TABLE users; --"])!="O'Brien; DROP TABLE users; --"){return 18;}
    if(db.Execute("DELETE FROM users WHERE id=3")!=1){return 19;}
    if((int)db.ExecuteScalar("SELECT COUNT(*) FROM users")!=3){return 20;}
    var a=new SqliteConnection(":memory:");a.Execute("CREATE TABLE isolated(id INTEGER)");
    a.Close();db.Close();db.Close();
    try {db.Query("SELECT 1");}catch(Exception e){caught=caught+1;}
    if(caught!=5){return 21;}
    var disk=new SqliteConnection("application.db");
    disk.Execute("CREATE TABLE IF NOT EXISTS records(id INTEGER PRIMARY KEY, value TEXT)");
    disk.Execute("DELETE FROM records");
    disk.ExecuteWith("INSERT INTO records(value) VALUES(@value)",["value":"persisted héllo 世界"]);
    var simultaneous=new SqliteConnection("application.db");
    if((string)simultaneous.ExecuteScalar("SELECT value FROM records")!="persisted héllo 世界"){return 22;}
    simultaneous.Close();disk.Close();
    var reopened=new SqliteConnection("application.db");
    if((string)reopened.ExecuteScalar("SELECT value FROM records")!="persisted héllo 世界"){return 23;}
    reopened.dispose();
    return 0;
}
var code=exercise();
if(code!=0){console.writeLine(code);exit(code);}
gc();
console.writeLine("SQLite OK: CRUD binding NULL Unicode numbers BLOB transactions prepared cleanup connections persistence");
